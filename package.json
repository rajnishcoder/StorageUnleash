{
  "name": "storage-unleashed",
  "productName": "StorageUnleashed",
  "version": "1.1.0",
  "private": true,
  "description": "Fast, modern, visual desktop storage analyzer for macOS & Windows.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:all": "npm run build && electron-builder -mw",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.storageunleashed.app",
    "productName": "StorageUnleashed",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "StorageUnleashed uses Apple Events to inspect Trash status and manage files in Finder safely.",
        "NSDesktopFolderUsageDescription": "StorageUnleashed needs access to scan and analyze disk storage on your Desktop.",
        "NSDocumentsFolderUsageDescription": "StorageUnleashed needs access to scan and analyze disk storage in Documents.",
        "NSDownloadsFolderUsageDescription": "StorageUnleashed needs access to scan and analyze disk storage in Downloads."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Storage Unleashed",
      "uninstallDisplayName": "Storage Unleashed"
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.7"
  }
}
